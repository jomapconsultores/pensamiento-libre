# =====================================
# Supabase
# =====================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# =====================================
# Stripe — Obtener en https://dashboard.stripe.com/apikeys
# =====================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# IDs de precios de Stripe (crear productos en el dashboard primero)
STRIPE_MEMBERSHIP_BASIC_PRICE_ID=price_xxxxx
STRIPE_MEMBERSHIP_PREMIUM_PRICE_ID=price_xxxxx
STRIPE_SERVICE_TALLER_PRICE_ID=price_xxxxx
STRIPE_SERVICE_CONSULTA_PRICE_ID=price_xxxxx

# =====================================
# General
# =====================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=jomapconsultores@gmail.com

# =====================================
# Panel admin (/admin) — cuentas nominales
# =====================================
# Firma de la cookie de sesión. OBLIGATORIA: sin ella el panel no abre.
# Genera una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# ARRANQUE, un solo uso: mientras la tabla admin_users esté vacía, estas
# credenciales sirven para entrar una vez y crear la primera cuenta de
# administrador. Después puedes borrarlas del entorno: cada persona entra con su
# propia cuenta y su propia clave, y las claves olvidadas las restablece un
# administrador desde /admin/usuarios.
# Requiere aplicar supabase/20260801_cuentas_admin.sql.
ADMIN_USERNAME=admin@ejemplo.com
ADMIN_PASSWORD=cambia-este-password

# Conexión directa a Postgres (para scripts de migración con scripts/apply-migration.mjs)
SUPABASE_DB_PASSWORD=tu_db_password

# =====================================
# Email (Resend - resend.com, gratis 100/día)
# =====================================
# Obtén tu API key en https://resend.com/api-keys (formato re_xxxxx)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=Fundación Pensamiento Libre <onboarding@resend.dev>
